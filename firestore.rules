rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    match /profiles/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.auth.uid == userId ||
        (request.resource.data.is_group == true && request.resource.data.admin_id == request.auth.uid)
      );
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        (resource.data.is_group == true && (resource.data.admin_id == request.auth.uid || request.auth.uid in resource.data.members))
      );
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
    
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if false;
    }
    
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.user_id == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likesCount', 'like_count', 'comment_count', 'commentsCount'])
      );
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }
    
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }
    
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }
    
    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.sender_id == request.auth.uid || 
        resource.data.receiver_id == request.auth.uid ||
        (resource.data.is_group == true && (resource.data.members != null && request.auth.uid in resource.data.members))
      );
      allow create: if isSignedIn() && request.resource.data.sender_id == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.sender_id == request.auth.uid || 
        resource.data.receiver_id == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.sender_id == request.auth.uid || 
        resource.data.receiver_id == request.auth.uid
      );
    }
    
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn();
    }
    
    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && (
        resource.data.sender_id == request.auth.uid || 
        resource.data.receiver_id == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.sender_id == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.sender_id == request.auth.uid || 
        resource.data.receiver_id == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.sender_id == request.auth.uid || 
        resource.data.receiver_id == request.auth.uid
      );
    }
    
    match /reels/{reelId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.user_id == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'likesCount', 'like_count', 'comment_count', 'commentsCount'])
      );
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }
    
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    match /story_views/{viewId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    match /typing_status/{statusId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        request.resource.data.sender_id == request.auth.uid ||
        statusId.matches('^' + request.auth.uid + '_.*')
      );
    }

    match /deleted_posts/{postId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false; 
    }
  }
}
